# Copy this file to .env. Never commit the populated .env file.

# Wallet to monitor. This must be a 42-character 0x address.
TARGET_ADDRESS=0x0000000000000000000000000000000000000000

# Alert when the remaining order value reaches this USD amount.
LARGE_ORDER_THRESHOLD=50000

# Telegram credentials. Leave both blank for log-only mode.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Runtime behavior.
ALERT_EXISTING_ON_STARTUP=true
ALERT_ORDER_CLOSURES=false
SEND_STARTUP_MESSAGE=false
DEBUG_MODE=false

# Recovery and network settings.
RECONCILE_INTERVAL_MS=30000
REQUEST_TIMEOUT_MS=10000
HEARTBEAT_INTERVAL_MS=30000
MAX_RECONNECT_DELAY_MS=30000
STATE_RETENTION_MS=604800000
STATE_FILE=seenOrders.json

# Override only for testing or alternate Hyperliquid environments.
HYPERLIQUID_INFO_ENDPOINT=https://api.hyperliquid.xyz/info
HYPERLIQUID_WS_ENDPOINT=wss://api.hyperliquid.xyz/ws
